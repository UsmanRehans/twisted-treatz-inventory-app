# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/twisted_treatz"

# ─── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without it.
# Generate a strong random value, e.g.:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Set to "production" on Railway so the JWT_SECRET guard is enforced.
NODE_ENV="development"

# ─── Email alerts (SendGrid) ─────────────────────────────────────────
# Leave as the placeholder to disable email; alerts are logged instead.
SENDGRID_API_KEY="placeholder-set-in-production"
ALERT_FROM_EMAIL="alerts@twistedtreatz.com"
ALERT_TO_EMAIL="owner@twistedtreatz.com"

# ─── Seeding (used only by `npm run db:seed`) ────────────────────────
# Initial admin credentials. The seed creates the admin ONLY if one does
# not already exist — it never overwrites a live password.
SEED_ADMIN_EMAIL="admin@twistedtreatz.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# ─── Optional server settings ────────────────────────────────────────
# Port the API listens on (default 3001).
PORT=3001

# Comma-separated extra browser origins allowed by CORS (e.g. a Vercel
# preview URL). The production frontend origin is always allowed, and
# localhost:5173/4173 are allowed whenever NODE_ENV is not "production".
CORS_EXTRA_ORIGINS=""

# Base URL of the admin frontend, used to build password-reset links.
# Defaults to https://inventory.twistedtreatz.com when unset.
APP_BASE_URL="https://inventory.twistedtreatz.com"

# Base URL for the "Receive Stock" button in low-stock emails.
# NOTE: when unset the code falls back to https://twistedtreatz.com (the
# marketing site), so set this explicitly wherever alert emails are enabled.
ADMIN_BASE_URL="https://inventory.twistedtreatz.com"

# Development only: boot without JWT_SECRET using a public fallback secret.
# Never set this in production.
# ALLOW_DEV_SECRET="true"
