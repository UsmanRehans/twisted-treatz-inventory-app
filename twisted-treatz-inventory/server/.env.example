# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/twisted_treatz"

# ─── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without it.
# Generate a strong random value, e.g.:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Set to "production" on Railway so the JWT_SECRET guard is enforced.
NODE_ENV="development"

# ─── Email alerts (SendGrid) ─────────────────────────────────────────
# Leave as the placeholder to disable email; alerts are logged instead.
SENDGRID_API_KEY="placeholder-set-in-production"
ALERT_FROM_EMAIL="alerts@twistedtreatz.com"
ALERT_TO_EMAIL="owner@twistedtreatz.com"

# ─── Seeding (used only by `npm run db:seed`) ────────────────────────
# Initial admin credentials. The seed creates the admin ONLY if one does
# not already exist — it never overwrites a live password.
SEED_ADMIN_EMAIL="admin@twistedtreatz.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"
