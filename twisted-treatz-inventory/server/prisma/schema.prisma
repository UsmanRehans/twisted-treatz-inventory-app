generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int       @id @default(autoincrement())
  name           String
  category       String
  flavor         String?
  purchaseUnit   String // "Bag", "Box", "Gallon", "Bucket" etc
  unitSize       String? // "5 lb", "128 oz" etc
  // Transitional: the original free-text brand column, renamed from `brand`.
  // Source for the one-time brand backfill; dropped once brandId is populated.
  brandText      String?
  brandId        Int?
  brand          Brand?    @relation(fields: [brandId], references: [id])
  supplier       String?
  usedIn         String? // which finished candy product it goes into
  currentQty     Int       @default(0)
  alertThreshold Int       @default(10)
  unitPrice      Decimal?  @db.Decimal(10, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  removals       Removal[]
  receipts       Receipt[]
  adjustments    Adjustment[]

  @@index([brandId])
}

// First-class brand entity. Promoted from the free-text Product.brand column
// (now Product.brandText, transitional). Soft-deleted via `active` — there is
// no hard DELETE, so the FK uses ON DELETE SET NULL as a safety net only.
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique // stored normalized/title-cased
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model TeamMember {
  id        Int       @id @default(autoincrement())
  name      String
  initials  String // e.g. "JR" for display avatar
  pinHash   String // bcrypt hashed 4-digit PIN
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  removals  Removal[]
}

model Admin {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  passwordHash      String
  name              String
  createdAt         DateTime  @default(now())
  // Forgot-password flow: SHA-256 hash of the emailed reset token (raw token
  // is never stored), nulled on use. Expiry enforced in the lookup query.
  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?
  // Session revocation: embedded in admin JWTs and checked on every
  // admin-authed request. Bumped on password change/reset to evict all
  // outstanding tokens. Tokens minted before this field existed count as 0.
  tokenVersion      Int       @default(0)
  receipts          Receipt[]
  adjustments       Adjustment[]
}

model Removal {
  id           Int        @id @default(autoincrement())
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  teamMemberId Int
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])
  qty          Int
  qtyBefore    Int // snapshot of qty before removal
  qtyAfter     Int // snapshot of qty after removal
  createdAt    DateTime   @default(now())
}

model Receipt {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  adminId     Int
  admin       Admin    @relation(fields: [adminId], references: [id])
  supplier    String?
  expectedQty Int
  actualQty   Int
  unitPrice   Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
}

// Admin stock correction (cycle count / bulk CSV import). Third movement
// type alongside Removal (floor takes) and Receipt (shipment adds).
model Adjustment {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  delta     Int // signed: +12 added, -5 removed
  qtyBefore Int // live qty at apply time — preserves overwritten floor activity
  qtyAfter  Int
  reason    String? // CSV "note" column
  batchId   String // uuid grouping all rows of one CSV import
  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([createdAt])
}

model AlertLog {
  id        Int      @id @default(autoincrement())
  productId Int
  sentAt    DateTime @default(now())
  // Prevents duplicate alerts per product per day
}
